# Variables de Vite solo para DESARROLLO LOCAL (sin Docker).
# En Docker la configuración vive en el archivo .env de la RAÍZ del proyecto
# y el bundle se compila con VITE_API_URL vacío (usa /api vía nginx).
#
# Vacío = Vite redirige /api al backend (ver vite.config.ts).
VITE_API_URL=

# Opcional: cambiar el destino del proxy de desarrollo.
# VITE_API_PROXY=http://localhost:8000
