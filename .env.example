# ===== Multi-Administrador · Docker Compose =====
# PLANTILLA: cópiala a .env (copy .env.example .env / cp .env.example .env).
# Este archivo SÍ se sube a GitHub: NUNCA pongas aquí contraseñas reales.
# La contraseña real va solo en .env, que está en .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=multiadmin
POSTGRES_PASSWORD=multiadmin
POSTGRES_DB=multiadmin_db

# --- Seguridad (cámbiala por una clave larga y aleatoria en producción) ---
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# --- Orígenes permitidos (CORS) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- URL del frontend (enlaces de verificación / recuperación) ---
FRONTEND_URL=http://localhost:3000

# --- URL de la API que consume el frontend (build arg) ---
# Si la cambias, reconstruye: docker compose up --build -d
VITE_API_URL=http://localhost:8000

# --- SMTP: verificación de cuenta y recuperación de contraseña ---
# Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Son 16 letras, SIN espacios.
# Reemplaza estos valores en tu .env (NO aquí).
EMAIL_USER=tu@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tu@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- Selector "Usuario / Administrador" en Crear cuenta ---
# true  = el registro público de administradores funciona (modo demo).
# false = seguro para producción: solo un admin autenticado puede crear admins.
PERMITIR_REGISTRO_ADMIN=true

# --- Chatbot ---
# local = motor con datos de la BD (sin API externa). llm = OpenAI (requiere key).
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging SQL
SQL_ECHO=false

# --- Notificaciones reales: Web Push (VAPID) ---
# Genera tus propias claves con:  python backend/generar_vapid.py --guardar
# La PRIVADA va SOLO en .env (gitignored). Aquí deja los marcadores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@gmail.com
# Interruptor de emergencia para los correos de notificaciones (true/false).
NOTIFICACIONES_CORREO=true
